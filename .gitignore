# Terraform files
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
# *.tfvars
# *.tfvars.json
# !example.tfvars

# Ignore override files, as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do want to commit
!example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# Ignore lock files (for most setups)
# Uncomment the line below if you want to version control lock files
# .terraform.lock.hcl

# Ignore private key files
*.pem
*.key
*.ppk

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
.gradle/
.project
.settings/
*.sublime-project
*.sublime-workspace

# OS files
Thumbs.db
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*.log

# Backup files
*.backup
*.bak
*.old

# Python related (if using Python scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node modules (if using any Node.js tools)
node_modules/
npm-debug.log
yarn-error.log

# IntelliJ
out/

# Maven
target/

# Gradle
.gradle/
build/

# Ansible
.ansible/
*.retry
